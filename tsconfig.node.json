{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    // Инструменты тянут формы обмена из contract, а сайт — из src через алиас.
    "paths": {
      "@/*": ["./src/*"],
      "@contract/*": ["./contract/*"]
    },

    /* Bundler mode */
    // bundler, а не nodenext: инструменты ходят в src, где принят алиас @ и импорты
    // без расширения. Сборкой этот проект не занимается, только проверкой типов.
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "tools/**/*.ts", "api/**/*.ts", "contract/**/*.ts"]
}
