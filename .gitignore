!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Временное сравнение ассетов.
public/compare/

# Журнал событий api — данные сезона, не исходники.
data/

# Сборка плагина. Обёртка gradle в репозитории нужна, результат сборки — нет.
plugin/*/build/
plugin/*/.gradle/

# Сервер. Под версией только docker-compose.yml, README и образец окружения:
# мир не исходник, чужие jar не наши, а ключ секрет.
server/data/
server/plugins/
server/plugins-old/
server/.env

# Кеш питона от tools/*.py — пересоздаётся сам.
__pycache__/

# Метки NTFS «файл скачан из интернета»: их создаёт windows рядом с картинкой.
*:Zone.Identifier
