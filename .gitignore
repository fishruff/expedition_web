# Предпросмотр рамок из tools/gen_frames.py — служебный, смотрят и удаляют.
frame-*-preview.png

# Снимки из игры: во время сезона их пишет api, на дев-машине — npm run data:sample.
# В репозитории им делать нечего, а в продакшн-сборке — тем более.
public/data

