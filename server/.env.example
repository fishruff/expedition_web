# Скопируйте в `.env` рядом и подставьте свой ключ: cp .env.example .env
#
# Ключ подписывает каждый запрос плагина к приёмнику. Он обязан быть из латиницы
# и цифр: заголовки HTTP не переносят кириллицу, ключ доедет искажённым, и приём
# будет молча отвечать «неверный ключ». Обе стороны берут его отсюда, поэтому
# разъехаться значения не могут.
EXPEDITION_KEY=смените-меня

# Даты сезона: событиями они не приходят, их знает настройка. Без них сайт
# не показывает отсчёт — это нормальный режим до объявления старта.
#SEASON_STARTS_AT=2026-09-01T18:00:00Z
#SEASON_STORY_ENDS_AT=2026-09-08T18:00:00Z
